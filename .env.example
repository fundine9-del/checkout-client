# Supabase project (same project as the checkout server + supermarket dashboard).
# Copy to .env and fill in your project URL and anon (publishable) key.
# NEVER put the service-role key in here — it ships to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY