# Supabase project (same project as the checkout server + supermarket dashboard).
# Copy to .env and fill in your project URL and anon (publishable) key.
# NEVER put the service-role key in here — it ships to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# API base. If unset, the app falls back to the deployed checkout server:
# https://checkout-production-bbfe.up.railway.app/api
# Set VITE_API_URL=/api to use the Vite dev proxy instead.
VITE_API_URL=https://checkout-production-bbfe.up.railway.app/api